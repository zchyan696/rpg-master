generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Character {
  id                  String    @id @default(cuid())
  name                String
  role                String    @default("resident")
  narrativeRole       String?
  occupation          String?
  description         String?
  alibi               String?
  connectionToVictim  String?
  secrets             String?
  notes               String?
  alive               Boolean   @default(true)
  primaryLocationId   String?
  primaryLocation     Location? @relation("primaryLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Location {
  id         String      @id @default(cuid())
  name       String
  category   String      @default("other")
  mapX       Float?
  mapY       Float?
  description String?
  notes      String?
  characters Character[] @relation("primaryLocation")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Clue {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("hidden")
  location    String?
  foundBy     String?
  sessionId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  number    Int
  title     String
  date      DateTime
  summary   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        String
  type        String   @default("event")
  createdAt   DateTime @default(now())
}
